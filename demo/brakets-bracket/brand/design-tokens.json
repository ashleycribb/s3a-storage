stages:
  - checkout
  - build
  - review

checkout_job:
  stage: checkout
  script:
    - mkdir -p /workspace/repo
    - cd /workspace/repo
    - git clone <repository-url> .
    - if [ ! -f package.json ]; then echo "package.json is missing"; exit 1; fi

build_job:
  stage: build
  script:
    - cd /workspace/repo
    - npm install
    - npm run build

review_job:
  stage: review
  script:
    - cd /workspace/repo
    - npm run visual-review -- demo/brakets-bracket/brand/design-tokens.json
visual_review_job:
  stage: review
  script:
    - cd /workspace/repo
    - npm run visual-review -- --target-file demo/brakets-bracket/brand/design-tokens.json
# Clean the workspace if it already exists
if [ -d "/workspace/repo" ]; then
  rm -rf /workspace/repo
fi

# Checkout the repository
git clone <repository-url> /workspace/repo

# Check for the presence of package.json
if [ ! -f "/workspace/repo/package.json" ]; then
  echo "Error: package.json absent in repository (/workspace/repo). Never proceed with build."
  exit 1
fi

