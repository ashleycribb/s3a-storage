#73=( CONVERSION_BASED_UNIT('MILLIMETRE', #74) LENGTH_UNIT() NAMED_UNIT(#75) );
#80=NEXT_ASSEMBLY_USAGE_OCCURRENCE('NAUO2', 'Seal In Gearbox', '', #30, #57, $);
ENDSEC;
