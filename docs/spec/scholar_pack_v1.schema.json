        { "name": "object_hash", "rust_field": "object_hash", "type": "U32", "type_code": 3, "byte_offset": 56, "byte_len": 4 },
        { "name": "flags", "rust_field": "flags", "type": "U32", "type_code": 3, "byte_offset": 60, "byte_len": 4 }
      ]
