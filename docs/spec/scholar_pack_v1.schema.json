{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ashleycribb/s3a-storage/blob/main/docs/spec/scholar_pack_v1.schema.json",
  "title": "S3A Scholar Pack v1 Contract (Tiles 10-15 + NoteClaims Tile 20)",
  "schema_version": "1.0.0",
  "record_layout_version": 1,
  "required_addon": {
    "name": "ADDON_EDU",
    "mask": 1
  },
  "invariants": {
    "ai_allowed_tiles": [11],
    "ai_provisional_metadata_tiles": [12, 13, 14, 20],
    "human_confirmation_required_tiles": [10],
    "human_confirmation_rule": "AI agents may only write AiTraceRecord (Tile 11) and provisional/suggested metadata. HumanLrsRecord (Tile 10) and final classification/verdict edges require explicit human confirmation or signature."
  },
  "tiles": {
    "10": {
      "tile_id": 10,
      "constant_name": "HUMAN_LRS",
      "struct_name": "HumanLrsRecord",
      "record_size": 64,
      "align": 8,
      "record_layout_version": 1,
      "human_confirmation_required": true,
      "ingest_file": "human_lrs.jsonl",
      "telemetry_extensions": {
        "dwell_time_ms": {
          "xapi_extension_id": "https://w3id.org/xapi/s3a/extensions/dwell_time_ms",
          "type": "integer",
          "minimum": 0,
          "description": "Milliseconds spent inspecting dossier, held PDF block, or diff before confirming/overriding."
        },
        "evidence_inspected": {
          "xapi_extension_id": "https://w3id.org/xapi/s3a/extensions/evidence_inspected",
          "type": "boolean",
          "description": "Whether the researcher opened review.html, checked a quote_sha256 anchor, or inspected a held/unverified block."
        },
        "override_delta": {
          "xapi_extension_id": "https://w3id.org/xapi/s3a/extensions/override_delta",
          "type": ["object", "null"],
          "properties": {
            "changed": { "type": "boolean" },
            "ai_suggested": { "type": ["string", "null"] },
            "human_selected": { "type": ["string", "null"] },
            "held_block_rejected": { "type": "boolean" },
            "needs_human_annotated": { "type": "boolean" }
          }
        },
        "note_substantiveness": {
          "xapi_extension_id": "https://w3id.org/xapi/s3a/extensions/note_substantiveness",
          "type": "object",
          "properties": {
            "char_count": { "type": "integer", "minimum": 0 },
            "token_count": { "type": "integer", "minimum": 0 },
            "citation_anchor_count": { "type": "integer", "minimum": 0 },
            "is_empty_template": { "type": "boolean" }
          }
        }
      },
      "ingest_fields": {
        "session_high": { "type": "integer", "minimum": 0 },
        "session_low": { "type": "integer", "minimum": 0 },
        "timestamp_sec": { "type": "integer", "minimum": 0 },
        "actor_hash": { "type": "integer", "minimum": 0 },
        "verb_id": { "type": "integer", "minimum": 0 },
        "decision_score": { "type": "number" },
        "object_hash": { "type": "integer", "minimum": 0 },
        "ai_tile": { "type": "integer", "minimum": 0 },
        "ai_record": { "type": "integer", "minimum": 0 }
      },
      "required_ingest_fields": [
        "session_high",
        "session_low",
        "timestamp_sec",
        "actor_hash",
        "verb_id",
        "decision_score",
        "object_hash",
        "ai_tile",
        "ai_record"
      ],
      "fields": [
        { "name": "session_uuid", "rust_field": "session_uuid", "type": "BYTES", "type_code": 13, "byte_offset": 0, "byte_len": 16 },
        { "name": "timestamp_sec", "rust_field": "timestamp_sec", "type": "U64", "type_code": 4, "byte_offset": 16, "byte_len": 8 },
        { "name": "actor_hash", "rust_field": "actor_hash", "type": "U64", "type_code": 4, "byte_offset": 24, "byte_len": 8 },
