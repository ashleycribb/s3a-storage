      },
      "exactMatch": ["http://activitystrea.ms/schema/1.0/search"]
    },
    {
      "id": "https://ashecribb.dev/xapi/activities/note",
      "type": "ActivityType",
      "inScheme": "https://ashecribb.dev/xapi/profiles/scholar-explorer/v1",
      "prefLabel": {
        "en": "research note"
      },
      "definition": {
