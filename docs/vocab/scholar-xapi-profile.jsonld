{
  "@context": "https://w3id.org/xapi/profiles/context",
  "id": "https://ashecribb.dev/xapi/profiles/scholar-explorer/v1",
  "type": "Profile",
  "conformsTo": "https://w3id.org/xapi/profiles#1.0",
  "prefLabel": {
    "en": "Scholar Explorer & Research Traceability Profile"
  },
  "definition": {
    "en": "Formal xAPI profile for verified scientific provenance, collaborative research workflows, citation fingerprinting, and dual human/AI trace ledgers in S3A."
  },
  "seeAlso": "https://ashecribb.dev/ontologies/scholar/v1",
  "versions": [
    {
      "id": "https://ashecribb.dev/xapi/profiles/scholar-explorer/v1",
      "wasRevisionOf": []
    }
  ],
  "author": {
    "type": "Organization",
    "name": "S3A Architecture Contributors",
    "url": "https://github.com/ashleycribb/s3a-storage"
  },
  "concepts": [
    {
      "id": "http://adlnet.gov/expapi/verbs/experienced",
      "type": "Verb",
      "inScheme": "https://ashecribb.dev/xapi/profiles/scholar-explorer/v1",
      "prefLabel": {
        "en": "experienced"
      },
      "definition": {
        "en": "Indicates that the actor was present at or engaged in an event or content interaction without active evaluation."
      },
      "exactMatch": ["http://adlnet.gov/expapi/verbs/experienced"]
    },
    {
      "id": "https://ashecribb.dev/xapi/verbs/reviewed",
      "type": "Verb",
      "inScheme": "https://ashecribb.dev/xapi/profiles/scholar-explorer/v1",
      "prefLabel": {
        "en": "reviewed"
      },
      "definition": {
        "en": "Indicates that an actor examined, analyzed, or appraised a scientific artifact, draft, or proposition."
      },
      "broadMatch": ["http://activitystrea.ms/schema/1.0/review"],
      "closeMatch": ["http://id.tincanapi.com/verb/reviewed"]
    },
    {
      "id": "https://ashecribb.dev/xapi/verbs/approved",
      "type": "Verb",
      "inScheme": "https://ashecribb.dev/xapi/profiles/scholar-explorer/v1",
      "prefLabel": {
        "en": "approved"
      },
      "definition": {
        "en": "Human supervisor judgment approving a draft, proposed analogy, claim, or policy transition. Disjoint with AI agents."
      },
      "broadMatch": ["http://activitystrea.ms/schema/1.0/accept"],
      "closeMatch": ["http://id.tincanapi.com/verb/approved"]
    },
    {
      "id": "https://ashecribb.dev/xapi/verbs/rejected",
      "type": "Verb",
      "inScheme": "https://ashecribb.dev/xapi/profiles/scholar-explorer/v1",
      "prefLabel": {
        "en": "rejected"
      },
      "definition": {
        "en": "Human supervisor judgment rejecting a draft, proposal, or claim. Disjoint with AI agents."
      },
      "broadMatch": ["http://activitystrea.ms/schema/1.0/reject"],
      "closeMatch": ["http://id.tincanapi.com/verb/rejected"]
    },
    {
      "id": "https://ashecribb.dev/xapi/verbs/requested-human-review",
      "type": "Verb",
      "inScheme": "https://ashecribb.dev/xapi/profiles/scholar-explorer/v1",
      "prefLabel": {
        "en": "requested-human-review"
      },
      "definition": {
        "en": "Indicates that an AI agent or automated evaluator has paused execution and requested human supervisory gate clearance."
      },
      "broadMatch": ["http://adlnet.gov/expapi/verbs/asked"],
      "closeMatch": ["http://id.tincanapi.com/verb/requested"]
    },
    {
      "id": "https://ashecribb.dev/xapi/verbs/flagged-hallucination",
      "type": "Verb",
      "inScheme": "https://ashecribb.dev/xapi/profiles/scholar-explorer/v1",
      "prefLabel": {
        "en": "flagged-hallucination"
      },
      "definition": {
        "en": "Flags an epistemic risk, ungrounded entity, unapproved pedagogical analogy, or factual contradiction generated by an AI model."
      },
      "broadMatch": ["http://activitystrea.ms/schema/1.0/flag-as-inappropriate"],
      "closeMatch": ["http://id.tincanapi.com/verb/flagged"]
    },
    {
      "id": "http://purl.org/spar/cito/cites",
      "type": "Verb",
      "inScheme": "https://ashecribb.dev/xapi/profiles/scholar-explorer/v1",
      "prefLabel": {
        "en": "cited"
      },
      "definition": {
        "en": "The citing entity cites the cited entity in its bibliography or provenance chain."
      },
      "exactMatch": ["http://purl.org/spar/cito/cites"]
    },
    {
      "id": "https://ashecribb.dev/xapi/verbs/imported",
      "type": "Verb",
      "inScheme": "https://ashecribb.dev/xapi/profiles/scholar-explorer/v1",
      "prefLabel": {
