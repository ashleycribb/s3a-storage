  ],
  "templates": [
    {
      "id": "https://ashecribb.dev/xapi/templates/ai-suggestion-statement",
      "type": "StatementTemplate",
      "inScheme": "https://ashecribb.dev/xapi/profiles/scholar-explorer/v1",
      "prefLabel": {
        "en": "AI Suggestion Statement"
      },
      "definition": {
        "en": "Template for an AI agent producing an answer, summary, or candidate claim proposition."
      },
      "verb": "https://ashecribb.dev/xapi/verbs/ai-answered",
      "rules": [
        {
          "location": "$.actor.account.homePage",
          "presence": "included"
        }
      ]
    },
    {
      "id": "https://ashecribb.dev/xapi/templates/human-edit-statement",
      "type": "StatementTemplate",
      "inScheme": "https://ashecribb.dev/xapi/profiles/scholar-explorer/v1",
      "prefLabel": {
        "en": "Human Edit Statement"
      },
      "definition": {
        "en": "Template for a human researcher modifying an AI suggestion or drafting proposition."
      },
      "verb": "https://ashecribb.dev/xapi/verbs/edited",
      "rules": [
        {
          "location": "$.actor.mbox",
          "presence": "recommended"
        }
      ]
    },
    {
      "id": "https://ashecribb.dev/xapi/templates/human-accept-statement",
      "type": "StatementTemplate",
      "inScheme": "https://ashecribb.dev/xapi/profiles/scholar-explorer/v1",
      "prefLabel": {
        "en": "Human Accept Statement"
      },
      "definition": {
        "en": "Template for a human supervisor approving or accepting a scientific artifact into the knowledge graph."
      },
      "verb": "https://ashecribb.dev/xapi/verbs/accepted",
      "rules": [
        {
          "location": "$.result.success",
          "presence": "included"
        }
      ]
    }
  ],
  "patterns": [
    {
      "id": "https://ashecribb.dev/xapi/patterns/ai-suggest-human-edit-accept",
      "type": "Pattern",
      "inScheme": "https://ashecribb.dev/xapi/profiles/scholar-explorer/v1",
      "prefLabel": {
        "en": "AI Suggestion → Human Edit → Human Accept Pattern"
      },
      "definition": {
        "en": "Canonical supervisory workflow: AI generates a draft or claim, the human researcher refines it, and the human supervisor records final acceptance."
      },
      "primary": true,
      "sequence": [
        "https://ashecribb.dev/xapi/templates/ai-suggestion-statement",
        "https://ashecribb.dev/xapi/templates/human-edit-statement",
        "https://ashecribb.dev/xapi/templates/human-accept-statement"
      ]
    }
  ]
}
