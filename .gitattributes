# Auto detect text files and perform LF normalization on checkout
* text=auto eol=lf

# Explicit binary rules for test fixtures and storage files
*.ots binary
*.txt binary
*.tsr binary
*.s3a binary
*.header binary
*.pdf binary -text
*.step binary -text
*.stp binary -text
tests/fixtures/** binary
**/tests/fixtures/** binary -text
crates/s3a-pack-tdp/tests/fixtures/** -text
conformance/** binary
