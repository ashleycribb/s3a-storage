  "files": ["dist", "README.md"],
  "engines": { "node": ">=18" },
  "repository": { "type": "git", "url": "git+https://github.com/ashleycribb/s3a-storage.git", "directory": "readers/js" },
  "scripts": {
    "build": "tsc -p .",
    "prepack": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "20.19.0",
    "typescript": "5.6.3"
  }
}
